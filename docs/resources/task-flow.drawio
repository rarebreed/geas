        <mxCell id="_0gZYpAKAERC22WxOP7c-9" value="Task 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="280" y="570" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_XsFNjHhJpjob5kO3uh-1" value="&lt;div&gt;A Task can be run as a Jenkins Job, a Lambda, a Step Function, etc etc.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;A Task is defined by several things:&lt;div&gt;- Inputs (arguments)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Triggered by event&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Subscriptions&lt;/div&gt;&lt;div&gt;- Outputs&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Publish topic&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Invokes&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Events generated&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - correlationId&lt;/div&gt;&lt;div&gt;- metadata&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - type (lambda, step func, jenkins job)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - state tables&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;A Task may publish its output to a topic, and it may also generate an event.&amp;nbsp; This allows other tasks to be notified asynchronously when another Task it is interested in has completed&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="471.5" y="20" width="321" height="290" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-1" value="bus, topic, or queue" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="130" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-5" value="bus, topic, or queue" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="30" y="490" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-6" value="bus, topic, or queue" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="310" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-7" value="bus, topic, or queue" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="490" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-25" value="A Task may have multiple triggers, each of which supplies a different set of required inputs.&amp;nbsp; The problem then becomes that we can&#39;t run the task until all inputs have been satisfied.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Since all Tasks run async, Task 2 may take 30min to complete, but 15min later, Task 1 is invoked again.&amp;nbsp; That means 3 and 4 may also run, but Task 5 still needs results from Task 2.&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;A state table must be declared for such stateful tasks.&amp;nbsp; One Task will save to the state table, and another will read from it. The correlationId will be used as a column key to get the matching state.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="471.5" y="460" width="329" height="185" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="K71fZYOm9OzprdUPYzZa-30" target="K71fZYOm9OzprdUPYzZa-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-34" value="event" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="K71fZYOm9OzprdUPYzZa-33" vertex="1" connectable="0">
          <mxGeometry x="-0.4321" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-30" value="state db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" parent="1" vertex="1">
          <mxGeometry x="50" y="330" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-38" value="Some questions:&lt;div&gt;- should all tasks save to a state table?&lt;/div&gt;&lt;div&gt;- how can we replay a failed Task?&lt;/div&gt;&lt;div&gt;- how do we programmatically build this out?&lt;/div&gt;&lt;div&gt;- Can we genericize this?&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="470" y="330" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="K71fZYOm9OzprdUPYzZa-39" value="Task 6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="280" y="700" width="120" height="60" as="geometry" />
        </mxCell>
